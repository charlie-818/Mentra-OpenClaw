{
  "name": "mentra-openclaw-bridge",
  "version": "1.0.0",
  "description": "Bridge Even G1 (MentraOS) glasses to OpenClaw: voice prompts to OpenClaw, streaming responses to glasses.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check": "bash scripts/check.sh",
    "test:openclaw": "node scripts/test-openclaw.js",
    "test:full": "bash scripts/test-full.sh"
  },
  "dependencies": {
    "@mentra/sdk": "^2.1.29",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
