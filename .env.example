# MentraOS (Even G1 glasses)
PORT=3000
PACKAGE_NAME=com.example.mentra-openclaw-bridge
MENTRAOS_API_KEY=88e0c52e92d734f6b97c5c23cb812f535a8c1d5a5d2f96a7e83ad472bd5b45b4

# OpenClaw Gateway (this repo uses HTTP Responses API)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_gateway_token
OPENCLAW_AGENT_ID=main

# For HexMentraBridge (full-featured bridge) use OPENCLAW_WS_URL (e.g. ws://127.0.0.1:18789) and OPENCLAW_GW_TOKEN instead; see https://github.com/johannboehme/HexMentraBridge and its .env.example
