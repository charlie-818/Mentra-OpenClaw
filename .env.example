# ── MentraOS (Even G1 glasses) ───────────────────────────────────────────────
PORT=3000
PACKAGE_NAME=com.example.mentra-openclaw-bridge
MENTRAOS_API_KEY=your_mentraos_api_key_here

# ── OpenClaw Gateway ──────────────────────────────────────────────────────────
# Local development: point directly at localhost
#   OPENCLAW_GATEWAY_URL=http://localhost:18789
#
# Production (Railway + Cloudflare Tunnel):
#   Run scripts/setup-cloudflare-tunnel.sh to get the tunnel URL, then use:
#   OPENCLAW_GATEWAY_URL=https://<tunnel-id>.cfargotunnel.com
#
OPENCLAW_GATEWAY_URL=https://<tunnel-id>.cfargotunnel.com
OPENCLAW_GATEWAY_TOKEN=your_gateway_token_here
OPENCLAW_AGENT_ID=main

# ── Voice Command Settings ────────────────────────────────────────────────────
# NOTE: These settings can also be configured in the Mentra smartphone app.
# App settings take precedence over environment variables.
# See app_config.json for available settings.
#
# OPENCLAW_TRIGGER_WORDS=mac,jarvis,send,execute
# OPENCLAW_CLEAR_WORDS=clear,stop,reset,cancel
# OPENCLAW_SYSTEM_PROMPT=<custom system prompt>

# ── Push API (same port as webhook) ───────────────────────────────────────────
# Optional. If set, require Bearer token or ?token= for /push, /status, /debug, etc.
# PUSH_TOKEN=your_push_token_here

# ── Copilot LLM pre-filter (optional) ───────────────────────────────────────
# When set, copilot transcripts are classified SKIP/RELEVANT before sending to OpenClaw.
# FILTER_LLM_URL=https://api.openai.com/v1/chat/completions
# FILTER_LLM_API_KEY=your_filter_llm_key
# FILTER_LLM_MODEL=haiku

# ── Agent Deployment (Cursor Cloud Agents) ────────────────────────────────────
# Get API key from Cursor dashboard: https://cursor.com/settings/api
# CURSOR_API_KEY=your_cursor_api_key_here
# CURSOR_API_URL=https://api.cursor.com/v0
# CURSOR_DEFAULT_REPO=https://github.com/your-org/your-repo

# ── Agent Deployment (Claude Agent SDK) ───────────────────────────────────────
# Get API key from Anthropic Console: https://platform.claude.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_AGENT_MODEL=claude-sonnet-4-20250514

# ── Claude Code Mode (Interactive CLI) ────────────────────────────────────────
# Say "code" or "open" to switch AI backends via voice
# Prerequisite: Claude Code CLI must be installed (npm install -g @anthropic-ai/claude-code)
#
# LOCAL SETUP (server runs on your Mac):
#   Just install Claude CLI and run `claude login` for Max subscription auth
#   CLAUDE_CODE_MODEL=claude-sonnet-4-20250514
#   CLAUDE_CODE_WORKING_DIR=/path/to/project  # Optional, defaults to cwd
#
# RAILWAY SETUP (server in cloud, Claude runs locally):
#   1. On your Mac, run the relay server:
#        npm run relay
#   2. Expose via tunnel:
#        ngrok http 3456
#        # or: cloudflared tunnel --url http://localhost:3456
#   3. Set these in Railway:
#        CLAUDE_RELAY_URL=https://xxx.ngrok.io
#        CLAUDE_RELAY_TOKEN=your_secret_token  # Optional but recommended
#   4. Set the same token locally:
#        CLAUDE_RELAY_TOKEN=your_secret_token
#
# CLAUDE_CODE_MODEL=claude-sonnet-4-20250514
# CLAUDE_CODE_WORKING_DIR=/path/to/project
# CLAUDE_RELAY_URL=https://xxx.ngrok.io
# CLAUDE_RELAY_TOKEN=your_secret_token

# ── Optional (environment variable fallbacks) ────────────────────────────────
# These can be configured in the Mentra app settings instead.
# Environment variables are used as fallback if app settings are not set.
#
# NOTIF_BLOCKLIST=System UI,Google Play Store
# TIMEZONE=America/Los_Angeles

# ── App Settings ─────────────────────────────────────────────────────────────
# The following settings are configurable through the Mentra smartphone app:
#
# General:
#   - show_live_transcription: Show real-time transcription on glasses
#   - response_speed: Word animation speed (fast/normal/slow)
#   - timezone: Timezone for status bar clock
#
# Voice Commands:
#   - trigger_words: Words that send message to AI
#   - clear_words: Words that clear the transcript
#   - copilot_mode_default: Start in copilot mode
#   - copilot_debounce_seconds: Batch delay for copilot mode
#
# Status Dashboard:
#   - show_dashboard: Show status dashboard when idle
#   - show_battery: Show battery level in status bar
#   - show_weather: Show temperature in status bar
#   - show_stock_price: Show SPY price in status bar
#   - dashboard_timeout_seconds: Auto-hide timeout
#   - response_timeout_seconds: Response display duration
#
# AI Configuration:
#   - default_ai_mode: Default backend (openclaw/claude)
#   - ai_response_style: Response style (concise/balanced/detailed)
#   - custom_system_prompt: Override default AI behavior
#   - head_up_delay_seconds: Head up activation delay
#
# AI Agents:
#   - enable_agent_commands: Allow voice agent deployment
#   - default_repository: Default GitHub repo for agents
#
# To configure these settings:
# 1. Upload app_config.json to the MentraOS Developer Console
# 2. Users can then adjust settings in the Mentra smartphone app
